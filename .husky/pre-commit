# Bloquea el commit si algún archivo agregado no pasa el mismo control que el Lint del CI:
# - PHP: errores de sintaxis o estilo de Laravel (Pint).
# - App mobile (mobile/): ESLint.

# --- App mobile -------------------------------------------------------------
mobiles=$(git diff --cached --name-only --diff-filter=ACMR -- 'mobile/*.ts' 'mobile/*.tsx' 'mobile/*.js' 'mobile/*.jsx' \
  | sed 's|^mobile/||')
if [ -n "$mobiles" ]; then
  if [ ! -d mobile/node_modules ]; then
    echo "pre-commit: hay archivos de la app y no están instaladas sus dependencias. Corré: cd mobile && npm install"
    exit 1
  fi
  (cd mobile && npx --no-install eslint --max-warnings=0 $mobiles) || {
    echo "pre-commit: ESLint encontró problemas en la app. Revisalos con: cd mobile && npm run lint"
    exit 1
  }
fi

# --- PHP --------------------------------------------------------------------
archivos=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')
[ -z "$archivos" ] && exit 0

# PHP del PATH o, si no está, el de Laragon.
php_bin=php
if ! command -v php >/dev/null 2>&1; then
  php_bin=$(ls -d /c/laragon/bin/php/php-*/php.exe 2>/dev/null | tail -n 1)
fi
if [ -z "$php_bin" ]; then
  echo "pre-commit: no se encontró PHP. Agregalo al PATH o instalá Laragon."
  exit 1
fi

for archivo in $archivos; do
  salida=$("$php_bin" -l "$archivo" 2>&1) || { echo "$salida"; echo "pre-commit: error de sintaxis en $archivo"; exit 1; }
done

"$php_bin" vendor/bin/pint --test $archivos || {
  echo "pre-commit: el estilo no respeta Pint. Corregilo con: php vendor/bin/pint"
  exit 1
}
